{
  "expo": {
    "name": "RoomVAI",
    "slug": "roomvai",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1115"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roomvai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "RoomVAI использует камеру для съёмки помещения.",
        "NSPhotoLibraryUsageDescription": "RoomVAI загружает фото помещения из галереи.",
        "NSPhotoLibraryAddUsageDescription": "RoomVAI сохраняет сгенерированные изображения в галерею.",
        "NSUserTrackingUsageDescription": "Используется для аналитики и улучшения приложения."
      }
    },
    "android": {
      "package": "com.roomvai.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f1115"
      }
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-apple-authentication",
        {
          "appleButtonStyle": "black",
          "buttonType": "continue"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "useFrameworks": "static" },
          "android": {}
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "roomvai"
      }
    }
  }
}
