# URL backend (FastAPI), проксирующего запросы к Replicate/Supabase.
# Для эмулятора Android: http://10.0.2.2:8000 ; iOS: http://localhost:8000
# Для реального устройства — IP компьютера в сети.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase (публичные ключи, безопасны для клиента)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# RevenueCat (публичный ключ)
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_YOUR_KEY

# PostHog (аналитика)
EXPO_PUBLIC_POSTHOG_KEY=phc_YOUR_KEY
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
