# --- Основные ---
DEBUG=true

# --- CORS: список через запятую. Для Expo используйте адрес хоста, напр.:
# CORS_ORIGINS=http://localhost:8081,http://192.168.1.5:8081
CORS_ORIGINS=*

# --- Каталоги ---
UPLOADS_DIR=uploads
OUTPUT_DIR=output

# --- ML ---
# mock — плейсхолдеры без нейросети (по умолчанию, удобно для разработки UI)
# sd   — реальная генерация через Stable Diffusion + ControlNet
ML_MODE=mock
ML_DEVICE=cpu
ML_NUM_INFERENCE_STEPS=30
ML_STRENGTH=0.75

# --- Лимиты ---
MAX_UPLOAD_SIZE_MB=20
