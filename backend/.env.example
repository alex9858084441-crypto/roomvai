# ============================================================
# RoomVAI Backend — пример переменных окружения
# ============================================================
# Скопируйте в .env и заполните реальными значениями.
# Файл .env НЕ коммитится (в .gitignore).

# --- Основные ---
# false в продакшене; true — подробные логи + autoreload.
DEBUG=false

# --- CORS: список через запятую. Для Expo dev: адрес хоста + порт Metro.
# В продакшене — домен API, напр.: https://api.roomvai.com
CORS_ORIGINS=*

# --- Каталоги ---
UPLOADS_DIR=uploads
OUTPUT_DIR=output

# --- Supabase (service_role — ТОЛЬКО для бэкенда, никогда не на клиент!) ---
# URL проекта БЕЗ /rest/v1/ — код добавляет путь сам.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SOURCE_IMAGES_BUCKET=source-images
RESULT_IMAGES_BUCKET=result-images

# --- Together AI API (ключ — ТОЛЬКО на бэкенде, раздел 10) ---
# Получить: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=YOUR_TOGETHER_KEY
# Модель: SDXL img2img — сохраняет структуру фото и применяет стиль.
TOGETHER_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# --- Аналитика (server-side PostHog для событий из webhook'ов) ---
POSTHOG_KEY=phc_YOUR_KEY

# --- ML-режим ---
# mock — генерация без Together AI/Supabase (для разработки и тестов).
# together — продакшен-режим через Together AI API.
ML_MODE=mock
ML_DEVICE=cpu
ML_NUM_INFERENCE_STEPS=30
ML_STRENGTH=0.75
ML_CONTROL_TYPE=depth
ML_IMAGE_SIZE=512
ML_MAX_CONCURRENCY=1

# --- Монетизация / лимиты ---
FREE_GENERATIONS_NO_AUTH=1
FREE_GENERATIONS_WITH_AUTH=1
MAX_IMAGE_DIMENSION=1536
MAX_UPLOAD_SIZE_MB=20
